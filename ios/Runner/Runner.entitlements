<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Firebase App Check (App Attest): 출시 빌드가 Gemini(AI Logic)를 호출할 수 있게 한다 -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
	<!-- 초대 링크(https://travelen-468bc.web.app/join/...)를 앱에서 연다. hosting/.well-known/apple-app-site-association과 짝 -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:travelen-468bc.web.app</string>
	</array>
</dict>
</plist>
